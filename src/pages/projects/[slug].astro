---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import { getProjects, num, statusLabel } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length], nextIndex: (i + 1) % projects.length },
  }));
}

const { project, index, next, nextIndex } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;
const sections = headings.filter((h) => h.depth === 2);
---
<Base title={`${d.title} · Mustafa Ahmed`} description={d.summary}>
  <section class="project-head wrap">
    <a class="back" href="/#work">← All work</a>
    <div class="featured-head meta">
      <span class={d.status === 'finished' ? 'badge ok' : 'badge'}>{statusLabel(d.status)}</span>
      <span>{num(index)} · {d.year}</span>
    </div>
    <h1>{d.title}</h1>
    <p class="dek">{d.summary}</p>
    <div class="meta-strip">
      <div>
        <span class="label">Stack</span>
        <ul class="chips">{d.stack.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div>
        <span class="label">Status</span>
        <span>{statusLabel(d.status)}</span>
      </div>
      <div>
        <span class="label">Source</span>
        {d.code ? <a href={d.code}>GitHub ↗</a> : <span class="muted">Private repo</span>}
      </div>
    </div>
  </section>

  {d.video && (
    <div class="project-media wrap">
      <Video src={d.video} poster={d.poster} caption={d.video_caption} title={d.title} />
    </div>
  )}

  <div class="wrap">
    <article class="prose">
      <aside class="note toc">
        <span class="label">On this page</span>
        <nav aria-label="On this page">
          {sections.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      </aside>
      <Content />
    </article>

    <a class="next" href={`/projects/${next.id}/`}>
      <span>
        <span class="label">Next project · {num(nextIndex)}</span>
        <b>{next.data.title}</b>
        <small>{next.data.summary}</small>
      </span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</Base>
