---
import { CHECKS, SCENARIOS, checkStates, type CheckState } from '../lib/panel';

// The HTML ships the finished refusal, so the panel reads fine with no JS or reduced motion.
const start = SCENARIOS.wall;
const states = checkStates(start.failAt);
const marks: Record<CheckState, string> = { pass: '✓', fail: '✗', skip: '·' };
---
<figure class="device" data-panel>
  <i class="screw tl"></i><i class="screw tr"></i><i class="screw bl"></i><i class="screw br"></i>

  <div class="plate">
    <b>WARDEN</b>
    <span>seven checks · every tool call</span>
  </div>

  <div class="face">
    <ol class="lights">
      {CHECKS.map((label, i) => (
        <li data-light data-state={states[i]}>
          <i class="led"></i>
          <span class="n">{i + 1}</span>
          <span class="name">{label}</span>
          <span class="m" data-mark>{marks[states[i]]}</span>
        </li>
      ))}
    </ol>

    <div class="screen">
      <div class="bar"><span>warden · tool call</span><span>replay</span></div>
      <dl>
        <dt>agent</dt><dd data-f="agent">{start.agent}</dd>
        <dt>for</dt><dd data-f="who">{start.who}</dd>
        <dt>asks for</dt><dd data-f="asks">{start.asks}</dd>
      </dl>
      <p class="code" data-code data-ok="false">{start.code}</p>
      <div aria-live="polite">
        <p class="reason" data-f="reason">{start.reason}</p>
        <p class="audit" data-f="audit">{start.audit}</p>
      </div>
    </div>
  </div>

  <div class="keys" role="group" aria-label="Replay a request through Warden">
    {Object.entries(SCENARIOS).map(([id, s]) => (
      <button type="button" data-run={id} aria-pressed={id === 'wall' ? 'true' : 'false'}>{s.label}</button>
    ))}
  </div>

  <figcaption>A replay of Warden's rulebook, not a live connection. The first "no" ends it.</figcaption>
</figure>

<script>
  import { SCENARIOS, checkStates, type CheckState, type ScenarioId } from '../lib/panel';

  const root = document.querySelector<HTMLElement>('[data-panel]');
  if (root) {
    const marks: Record<CheckState, string> = { pass: '✓', fail: '✗', skip: '·' };
    const lights = [...root.querySelectorAll<HTMLElement>('[data-light]')];
    const code = root.querySelector<HTMLElement>('[data-code]')!;
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-f="${name}"]`)!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-run]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let latest = 0;

    const paint = (i: number, state: CheckState | 'idle') => {
      lights[i].dataset.state = state;
      lights[i].querySelector<HTMLElement>('[data-mark]')!.textContent = state === 'idle' ? '' : marks[state];
    };

    async function run(id: ScenarioId) {
      const mine = ++latest;
      const s = SCENARIOS[id];
      const states = checkStates(s.failAt);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.run === id)));
      field('agent').textContent = s.agent;
      field('who').textContent = s.who;
      field('asks').textContent = s.asks;

      if (!still) {
        lights.forEach((_, i) => paint(i, 'idle'));
        code.textContent = '···';
        code.dataset.ok = 'wait';
        field('reason').textContent = '';
        field('audit').textContent = '';
      }
      for (const [i, state] of states.entries()) {
        if (!still && state !== 'skip') await sleep(240);
        if (mine !== latest) return;
        paint(i, state);
      }
      code.textContent = s.code;
      code.dataset.ok = String(s.failAt === null);
      field('reason').textContent = s.reason;
      field('audit').textContent = s.audit;
    }

    buttons.forEach((b) => b.addEventListener('click', () => run(b.dataset.run as ScenarioId)));
    root.dataset.ready = '';

    if (!still) {
      const seen = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { seen.disconnect(); run('wall'); }
      }, { threshold: 0.5 });
      seen.observe(root);
    }
  }
</script>

<style>
  /* Hardware keeps its own fixed colours in light and dark, like a real object would. */
  .device {
    --ink: #24211A; --ink-soft: #5A5344; --edge: #BDB39C;
    position: relative; width: 100%; max-width: 940px; margin-inline: auto; padding: 26px 34px 22px;
    display: flex; flex-direction: column; gap: 18px; color: var(--ink);
    background: linear-gradient(180deg, #F0EADC, #DFD6C3);
    border: 1px solid #C9BFA9; border-radius: 26px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7), 0 5px 0 var(--edge), 0 32px 56px -20px rgba(40,30,10,.4);
  }
  .screw { position: absolute; width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(45deg, transparent 44%, #7E7664 44% 56%, transparent 56%), #CFC6B2; box-shadow: inset 0 1px 1px rgba(0,0,0,.3), 0 1px 0 rgba(255,255,255,.7); }
  .tl { top: 12px; left: 12px; } .tr { top: 12px; right: 12px; transform: rotate(40deg); }
  .bl { bottom: 12px; left: 12px; transform: rotate(80deg); } .br { bottom: 12px; right: 12px; transform: rotate(15deg); }

  .plate { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 16px; padding-inline: 4px; }
  .plate b { font-size: 18px; font-weight: 600; letter-spacing: 0.22em; }
  .plate span { font-family: var(--mono); font-size: 12px; color: var(--ink-soft); }

  .face { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 16px; }

  .lights { list-style: none; padding: 16px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; background: #D8CFBB; border-radius: 14px; box-shadow: inset 0 2px 4px rgba(60,45,15,.22), inset 0 -1px 0 rgba(255,255,255,.5); font-size: 14px; line-height: 1.3; }
  .lights li { display: grid; grid-template-columns: 16px 14px minmax(0, 1fr) 14px; align-items: center; gap: 10px; }
  .n, .m { font-family: var(--mono); font-size: 12.5px; color: var(--ink-soft); }
  .m { text-align: right; }
  .led { width: 14px; height: 14px; border-radius: 50%; background: #AFA691; box-shadow: inset 0 1px 2px rgba(0,0,0,.35); transition: background .12s, box-shadow .12s; }
  [data-state="pass"] .led { background: #2FB26F; box-shadow: inset 0 1px 1px rgba(255,255,255,.6), 0 0 10px 1px rgba(47,178,111,.75); }
  [data-state="fail"] .led { background: #E0452A; box-shadow: inset 0 1px 1px rgba(255,255,255,.6), 0 0 12px 2px rgba(224,69,42,.8); }
  [data-state="fail"] .name, [data-state="fail"] .m { color: #9E2A12; font-weight: 600; }
  [data-state="skip"] .name { color: var(--ink-soft); }

  .screen { min-width: 0; padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; background: #10150F; color: #BFE8C7; border-radius: 14px; border: 3px solid #2B2A22; box-shadow: inset 0 0 28px rgba(80,200,120,.08); font-family: var(--mono); font-size: 13px; line-height: 1.5; }
  .bar { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: #86A98D; }
  dl { margin: 0; display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 2px 10px; }
  dt { color: #86A98D; }
  dd { margin: 0; overflow-wrap: anywhere; }
  .code { font-size: 40px; line-height: 1.1; font-weight: 500; letter-spacing: -0.02em; }
  .code[data-ok="false"] { color: #FF8E74; }
  .code[data-ok="true"] { color: #6FE3A0; }
  .code[data-ok="wait"] { color: #86A98D; }
  .reason, .audit { min-height: 1.5em; overflow-wrap: anywhere; }
  .audit { color: #86A98D; }

  .keys { display: none; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding-bottom: 4px; }
  [data-ready] .keys { display: grid; }
  .keys button { min-height: 48px; padding: 6px 12px; color: var(--ink); background: #FAF6EC; border: 1px solid #C9BFA9; border-radius: 12px; box-shadow: 0 4px 0 var(--edge); font: 500 14px/1.2 var(--sans); cursor: pointer; transition: transform .08s, box-shadow .08s; }
  .keys button:hover { background: #FFFDF6; }
  .keys button:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--edge); }
  .keys button[aria-pressed="true"] { color: #FAF6EC; background: var(--ink); border-color: var(--ink); }

  figcaption { padding-inline: 4px; font-size: 13px; line-height: 1.45; text-align: center; color: var(--ink-soft); }

  @media (max-width: 720px) {
    .device { padding: 24px 18px 18px; }
    .face { grid-template-columns: minmax(0, 1fr); }
    .keys { grid-template-columns: minmax(0, 1fr); }
    .code { font-size: 32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .led, .keys button { transition: none; }
  }
</style>
