---
interface Item {
  note: string; org: string; role: string; dates: string;
  lead: string; bullets: string[]; stack: string[];
}
interface Props { items: Item[]; }
const { items } = Astro.props;

// Fan position per card; the current job sits in the middle.
const fan = [0, -1, 1, -2, 2];
---
<div class="env">
  <div class="fan" role="radiogroup" aria-label="Choose a role to read about">
    {items.map((item, i) => (
      <label class={`card c${i}`} style={`--n: ${fan[i]}`}>
        <input type="radio" name="job" id={`job-${i}`} checked={i === 0}>
        <span class="kicker">{item.note}</span>
        <b>{item.org}</b>
        <span class="role">{item.role}</span>
        <span class="dates">{item.dates}</span>
      </label>
    ))}
    <div class="pocket" aria-hidden="true"></div>
  </div>

  <div class="details">
    {items.map((item, i) => (
      <article class={`d${i}`}>
        <header>
          <h3>{item.role} <span>· {item.org}</span></h3>
          <span class="dates">{item.dates}</span>
        </header>
        <p>{item.lead}</p>
        {item.bullets.length > 0 && <ul class="bullets">{item.bullets.map((b) => <li>{b}</li>)}</ul>}
        {item.stack.length > 0 && <ul class="chips">{item.stack.map((s) => <li>{s}</li>)}</ul>}
      </article>
    ))}
  </div>
</div>

<style>
  .env { display: flex; flex-direction: column; gap: 32px; }

  .fan { position: relative; height: 400px; }
  .card {
    --ink: #24211A;
    position: absolute; left: 50%; top: 0; width: 226px; height: 300px; margin-left: -113px; padding: 20px 22px;
    display: flex; flex-direction: column; gap: 4px; color: var(--ink); background: var(--tint);
    border: 1px solid rgba(40,30,10,.18); border-radius: 14px; box-shadow: 0 10px 24px -12px rgba(40,30,10,.45); cursor: pointer;
    transform: translate(calc(var(--n) * min(19vw, 204px)), calc(var(--n) * var(--n) * 11px + 34px)) rotate(calc(var(--n) * 5deg));
    z-index: calc(5 - var(--n) * var(--n));
    transition: transform .22s ease;
  }
  .card:hover { transform: translate(calc(var(--n) * min(19vw, 204px)), calc(var(--n) * var(--n) * 11px + 22px)) rotate(calc(var(--n) * 5deg)); }
  .card:has(input:checked) { z-index: 9; box-shadow: 0 18px 32px -12px rgba(40,30,10,.55); transform: translate(calc(var(--n) * min(19vw, 204px)), 0) rotate(0); }
  .card:has(input:focus-visible) { outline: 2px solid var(--ink); outline-offset: 3px; }
  .card input { position: absolute; opacity: 0; pointer-events: none; }
  .c0 { --tint: #F2C48D; } .c1 { --tint: #B9D8C2; } .c2 { --tint: #E7B7A3; } .c3 { --tint: #B8CBDD; } .c4 { --tint: #EFE3C2; }
  .kicker, .dates { font-family: var(--mono); font-size: 12px; line-height: 1.5; }
  .kicker { padding-bottom: 8px; margin-bottom: 8px; border-bottom: 1px solid rgba(40,30,10,.3); text-transform: uppercase; letter-spacing: 0.06em; }
  .card b { font-size: 24px; line-height: 1.15; font-weight: 600; letter-spacing: -0.02em; }
  .role { font-size: 15px; line-height: 1.35; }

  .pocket { position: absolute; left: 50%; bottom: 0; z-index: 10; width: min(100%, 960px); height: 170px; transform: translateX(-50%); pointer-events: none; background: linear-gradient(180deg, #F7F1E3, #E8DFCC); border: 1px solid #CFC5B1; border-radius: 6px 6px 22px 22px; clip-path: polygon(0 0, 50% 46%, 100% 0, 100% 100%, 0 100%); box-shadow: 0 16px 32px -18px rgba(40,30,10,.5); }

  .details { max-width: 820px; width: 100%; margin-inline: auto; }
  @supports selector(:has(*)) {
    .details article { display: none; }
    .env:has(#job-0:checked) .d0, .env:has(#job-1:checked) .d1, .env:has(#job-2:checked) .d2,
    .env:has(#job-3:checked) .d3, .env:has(#job-4:checked) .d4 { display: flex; }
  }
  article { display: flex; flex-direction: column; gap: 12px; padding: 28px 32px; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; }
  article + article { margin-top: 16px; }
  @supports selector(:has(*)) { article + article { margin-top: 0; } }
  article header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 16px; }
  article .dates { color: var(--muted); font-size: 13px; }
  h3 { font-size: 20px; line-height: 1.35; letter-spacing: -0.015em; }
  h3 span { color: var(--muted); font-weight: 400; }
  article p { font-size: 16px; line-height: 1.55; color: var(--body); }
  .bullets { padding-left: 20px; display: flex; flex-direction: column; gap: 6px; font-size: 15px; line-height: 1.5; color: var(--body); }

  /* No fan once cards would collide: a plain, tappable list. */
  @media (max-width: 1000px) {
    .fan { height: auto; display: flex; flex-direction: column; gap: 10px; }
    .card, .card:hover, .card:has(input:checked) { position: relative; left: auto; width: 100%; height: auto; margin: 0; padding: 14px 18px; transform: none; }
    .card:has(input:checked) { outline: 2px solid var(--ink); outline-offset: -2px; }
    .kicker { padding: 0; margin: 0; border: 0; }
    .card b { font-size: 21px; }
    .pocket { display: none; }
    article { padding: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>
